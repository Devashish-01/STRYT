# Copy to .env and fill in values. Required for local dev and Vercel production.
# Never commit .env — it is gitignored.

# ── Supabase (required) ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Firebase / Google sign-in (required) ─────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Web push (required for browser notifications on stryt.in) ─────────────────
VITE_VAPID_PUBLIC_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
VITE_USE_MOCKS=false
VITE_APP_URL=https://stryt.in
VITE_API_URL=https://stryt.in
VITE_TERMS_URL=https://stryt.in/legal/terms-and-conditions
VITE_PRIVACY_URL=https://stryt.in/legal/privacy-policy
VITE_MAPBOX_TOKEN=
VITE_DEFAULT_LAT=18.536
VITE_DEFAULT_LNG=73.893
VITE_DEFAULT_COUNTRY=IN
VITE_BUG_REPORT_EXCEL_URL=
VITE_BUG_REPORT_SCRIPT_URL=

# ── Supabase Edge Function secrets (set in Supabase Dashboard, not in .env) ──
# SMTP_PASS              — send-support-email
# VAPID_PRIVATE_KEY      — send-push (web)
# FIREBASE_SERVICE_ACCOUNT — send-push (Android FCM)
# SUPABASE_SERVICE_ROLE_KEY — purge-deleted-accounts cron (GitHub Actions secret)

# ── Android local release builds (not needed for CI) ─────────────────────────
# RELEASE_STORE_PASSWORD=
# RELEASE_KEY_PASSWORD=
