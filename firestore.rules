rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// STRYT does not use Cloud Firestore for application data. Its
// customer, shop, delivery, and location data is held in Supabase.
// No Firestore collection, client query, or client write is part of
// the supported application model.
//
// This is intentionally a deny-by-default baseline. A collection may
// only be added after its schema, queries, ownership model, and data
// validation have been designed and reviewed with matching rules.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Direct client access is prohibited until a collection-specific model
      // and matching validators are intentionally added.
      allow read, write: if false;
    }
  }
}
